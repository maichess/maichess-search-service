{
  "stryker-config": {
    "project": "MaichessSearchService.csproj",
    "solution": "../maichess-search-service.sln",
    "test-projects": [
      "MaichessSearchService.Tests.csproj"
    ],
    "reporters": [
      "progress",
      "html"
    ],
    "mutation-level": "Standard",
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 0
    },
    "mutate": [
      "!**/Program.cs",
      "!**/*.g.cs",
      "!**/*.generated.cs",
      "!**/Search/Elastic/ElasticSearchIndex.cs",
      "!**/Kafka/CdcIndexer.cs",
      "!**/Reindex/ReindexService.cs",
      "!**/Rest/**"
    ],
    "ignore-methods": [
      "*Log*",
      "Console.Write*"
    ]
  }
}
